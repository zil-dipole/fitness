# Copy to backup.env on the Raspberry Pi and adjust host-specific backup settings.

# Local backup storage on the Pi.
BACKUP_DIR=/opt/fitness-bot/backups/postgres
BACKUP_RETENTION_DAYS=14

# Optional rsync destination for copying each backup after it is created.
# Use deploy/enable-google-drive-postgres-rsync.sh to populate this for Google Drive.
BACKUP_RSYNC_TARGET=
BACKUP_RSYNC_OPTIONS="-az --mkpath"
