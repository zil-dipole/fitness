# Copy this file to deploy/.env and fill real secrets before starting.

# HTTP binding. Keep 127.0.0.1 behind nginx/caddy; use 0.0.0.0 only if exposing directly.
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080

# App image. Build/push with deploy/build-push-image.sh and set the produced tag here.
APP_IMAGE=mghostl/fitness-bot:latest

# Database
POSTGRES_DB=fitness_bot
POSTGRES_USER=fitness_bot
POSTGRES_PASSWORD=change-this-long-random-password

# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-real-token
TELEGRAM_BOT_USERNAME=zil_fit_bot

# AI parser. OPENAI_* takes precedence; NEBIUS_* is also supported by the app.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1/
OPENAI_MODEL=openai/gpt-oss-120b-fast

# Admin HTTP API basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-random-password
